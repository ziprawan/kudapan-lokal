# Telegram Bot API token from @BotFather (required unless using -dry-run)
TELEGRAM_BOT_TOKEN=
# Target Telegram user/group/channel ID for watcher notifications (required unless using -dry-run)
TELEGRAM_CHAT_ID=

# HTTP listen address for the webhook server (e.g. :8080; leave empty to disable)
WEBHOOK_LISTEN_ADDR=:8080

# Optional secret token verified via X-Telegram-Bot-Api-Secret-Token on POST /api/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=

# Discord application Ed25519 public key (64-char hex) from Developer Portal; enables POST /api/webhook/discord
DISCORD_PUBLIC_KEY=
# Discord application ID and bot token (auto-syncs slash commands & sends scheduled notifications)
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# Dedicated SQLite database path for Discord guild config & event tracker
DISCORD_DB_PATH=data/discord.db
